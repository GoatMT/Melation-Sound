rules_version = '2';

// Melation uses the same Firestore-only account model as the LSL site:
// username + PIN hash, with no Firebase Authentication account. Because
// Firestore Rules cannot verify that client-side identity, these rules shape
// the data but cannot prevent a determined client from impersonating a user.
service cloud.firestore {
  match /databases/{database}/documents {
    match /melationSound/{releaseId} {
      allow read: if true;
      allow write: if false;

      match /accounts/{accountId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
          "username", "usernameKey", "displayName", "pinHash", "createdAtMs"
        ]);
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "username", "usernameKey", "pinHash", "totalSeconds", "uniqueSongs", "plays", "playlist", "profileBio", "profileImage", "favoriteSong", "streakDays", "lastActiveDate", "recentTracks", "listenerZone", "updatedAtMs"]);
        allow delete: if true;

        match /listens/{songId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll([
            "songId", "title", "artist", "art", "seconds", "plays", "updatedAtMs"
          ]);
          allow delete: if false;
        }

        match /reactions/{songId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll([
            "songId", "type", "title", "artist", "art", "updatedAtMs"
          ]) && request.resource.data.type in ["like", "dislike"];
          allow delete: if true;
        }
      }

      match /songs/{songId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll([
          "id", "title", "artist", "art", "views", "likesBy", "dislikesBy", "updatedAtMs"
        ]);
        allow delete: if false;
      }

      match /rooms/{roomId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll([
          "id", "name", "host", "ownerKey", "trackIds", "currentIndex", "active", "createdAtMs", "updatedAtMs"
        ]) && request.resource.data.name is string
          && request.resource.data.trackIds is list
          && request.resource.data.active is bool;
        allow delete: if false;

        match /presence/{presenceId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll(["joinedAtMs", "lastSeenMs"])
            && request.resource.data.joinedAtMs is number
            && request.resource.data.lastSeenMs is number;
          allow delete: if true;
        }

        match /chat/{messageId} {
          allow read: if true;
          allow create: if request.resource.data.keys().hasAll([
            "author", "authorKey", "body", "createdAtMs"
          ]) && request.resource.data.author is string
            && request.resource.data.author.size() > 0
            && request.resource.data.author.size() <= 40
            && request.resource.data.authorKey is string
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 300
            && request.resource.data.createdAtMs is number;
          allow update, delete: if false;
        }

        match /requests/{requestId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll([
            "viewerName", "viewerKey", "createdAtMs", "status"
          ]) && request.resource.data.viewerName is string
            && request.resource.data.viewerName.size() > 0
            && request.resource.data.viewerName.size() <= 40
            && request.resource.data.viewerKey is string
            && request.resource.data.createdAtMs is number
            && request.resource.data.status == "pending";
          allow delete: if false;
        }
      }

      match /songComments/{songId}/comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
          "author", "usernameKey", "body", "createdAtMs"
        ]) && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 500;
        allow update, delete: if false;
      }

      // Download keys are stored by SHA-256 hash; the raw 13-digit key is not
      // written to Firestore. This client-only admin model is a convenience
      // gate, not secure payment DRM. Use Firebase Auth + a trusted backend
      // before relying on it for protected sales.
      match /downloadKeys/{keyHash} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
          "songId", "songTitle", "keyLast4", "active", "uses", "createdAtMs", "updatedAtMs"
        ]) && request.resource.data.songId is string
          && request.resource.data.keyLast4 is string
          && request.resource.data.keyLast4.size() == 4
          && request.resource.data.active is bool;
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["active", "uses", "lastUsedAtMs", "updatedAtMs"]);
        allow delete: if true;
      }
    }
  }
}
