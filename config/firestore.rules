rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /melationSound/{releaseId} {
      allow read: if true;
      allow write: if false;

      match /accounts/{accountId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
          "username", "usernameKey", "displayName", "pinHash", "createdAtMs"
        ]);
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "username", "usernameKey", "pinHash", "totalSeconds", "uniqueSongs", "plays", "playlist", "profileBio", "profileImage", "favoriteSong", "streakDays", "lastActiveDate", "recentTracks", "listenerZone", "updatedAtMs"]);
        allow delete: if true;

        match /listens/{songId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll([
            "songId", "title", "artist", "art", "seconds", "plays", "updatedAtMs"
          ]);
          allow delete: if false;
        }

        match /reactions/{songId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll([
            "songId", "type", "title", "artist", "art", "updatedAtMs"
          ]) && request.resource.data.type in ["like", "dislike"];
          allow delete: if true;
        }
      }

      match /songs/{songId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll([
          "id", "title", "artist", "art", "views", "likesBy", "dislikesBy", "updatedAtMs"
        ]);
        allow delete: if false;
      }

      match /periodListeners/{periodId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll([
          "periodKey", "periodType", "periodStartMs", "usernameKey", "displayName", "totalSeconds", "plays", "songIds", "updatedAtMs"
        ]) && request.resource.data.periodType in ["week", "month"]
          && request.resource.data.periodKey is string
          && request.resource.data.usernameKey is string
          && request.resource.data.displayName is string
          && request.resource.data.periodStartMs is number
          && request.resource.data.totalSeconds is number
          && request.resource.data.plays is number
          && request.resource.data.songIds is list;
        allow delete: if false;
      }

      match /periodSongs/{periodId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll([
          "periodKey", "periodType", "periodStartMs", "songId", "title", "artist", "art", "seconds", "plays", "updatedAtMs"
        ]) && request.resource.data.periodType in ["week", "month"]
          && request.resource.data.periodKey is string
          && request.resource.data.songId is string
          && request.resource.data.title is string
          && request.resource.data.artist is string
          && request.resource.data.seconds is number
          && request.resource.data.plays is number;
        allow delete: if false;
      }

      match /rooms/{roomId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll([
          "id", "name", "host", "ownerKey", "trackIds", "currentIndex", "active", "createdAtMs", "updatedAtMs"
        ]) && request.resource.data.name is string
          && request.resource.data.trackIds is list
          && request.resource.data.active is bool
          && (!request.resource.data.keys().hasAny(["visibility"])
            || request.resource.data.visibility in ["public", "private"]);
        allow delete: if false;

        match /presence/{presenceId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll(["joinedAtMs", "lastSeenMs"])
            && request.resource.data.joinedAtMs is number
            && request.resource.data.lastSeenMs is number;
          allow delete: if true;
        }

        match /chat/{messageId} {
          allow read: if true;
          allow create: if request.resource.data.keys().hasAll([
            "author", "authorKey", "body", "createdAtMs"
          ]) && request.resource.data.author is string
            && request.resource.data.author.size() > 0
            && request.resource.data.author.size() <= 40
            && request.resource.data.authorKey is string
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 300
            && request.resource.data.createdAtMs is number;
          allow update, delete: if false;
        }

        match /requests/{requestId} {
          allow read: if true;
          allow create: if request.resource.data.keys().hasAll([
            "viewerName", "viewerKey", "createdAtMs", "status"
          ]) && request.resource.data.viewerName is string
            && request.resource.data.viewerName.size() > 0
            && request.resource.data.viewerName.size() <= 40
            && request.resource.data.viewerKey is string
            && request.resource.data.createdAtMs is number
            && request.resource.data.status == "pending";
          allow update: if request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "respondedAtMs", "responderKey"])
            && request.resource.data.status in ["approved", "ignored"]
            && request.resource.data.respondedAtMs is number
            && request.resource.data.responderKey is string
            && get(/databases/$(database)/documents/melationSound/main/rooms/$(roomId)).data.ownerKey == request.resource.data.responderKey;
          allow delete: if false;
        }
      }

      match /songComments/{songId}/comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
          "author", "usernameKey", "body", "createdAtMs"
        ]) && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 500;
        allow update, delete: if false;
      }

      match /downloadKeys/{keyHash} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
          "songId", "songTitle", "keyLast4", "active", "uses", "createdAtMs", "updatedAtMs"
        ]) && request.resource.data.songId is string
          && request.resource.data.keyLast4 is string
          && request.resource.data.keyLast4.size() == 4
          && request.resource.data.active is bool;
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["active", "uses", "lastUsedAtMs", "updatedAtMs"]);
        allow delete: if true;
      }
    }
  }
}
