rules_version = '2';

// Melation uses the same Firestore-only account model as the LSL site:
// username + PIN hash, with no Firebase Authentication account. Because
// Firestore Rules cannot verify that client-side identity, these rules shape
// the data but cannot prevent a determined client from impersonating a user.
service cloud.firestore {
  match /databases/{database}/documents {
    match /melationSound/{releaseId} {
      allow read: if true;
      allow write: if false;

      match /accounts/{accountId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
          "username", "usernameKey", "displayName", "pinHash", "createdAtMs"
        ]);
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "username", "usernameKey", "pinHash", "totalSeconds", "uniqueSongs", "plays", "playlist", "updatedAtMs"]);
        allow delete: if true;

        match /listens/{songId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll([
            "songId", "title", "artist", "art", "seconds", "plays", "updatedAtMs"
          ]);
          allow delete: if false;
        }

        match /reactions/{songId} {
          allow read: if true;
          allow create, update: if request.resource.data.keys().hasAll([
            "songId", "type", "title", "artist", "art", "updatedAtMs"
          ]) && request.resource.data.type in ["like", "dislike"];
          allow delete: if true;
        }
      }

      match /songs/{songId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAll([
          "id", "title", "artist", "art", "views", "likesBy", "dislikesBy", "updatedAtMs"
        ]);
        allow delete: if false;
      }

      match /songComments/{songId}/comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
          "author", "usernameKey", "body", "createdAtMs"
        ]) && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 500;
        allow update, delete: if false;
      }
    }
  }
}
